   "source": [
    "class Tombolist(list):\n",
    "    def pick(self):\n",
    "        if self:\n",
    "            position = randrange(len(self))\n",
    "            return self.pop(position)\n",
    "        else:\n",
    "            raise LoockError('pop from empty TOMBOLIST')"
   ]
